// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FollowerStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  username   String   @unique
  name       String
  profilePic String?  @default("")
  bio        String?  @default("")
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sentFollowers     Follower[] @relation("UserSent")
  receivedFollowers Follower[] @relation("UserReceived")

  sentMessage     Chat[] @relation("sentMessages")
  receivedMessage Chat[] @relation("receivedMessages")

  notificationsReceived Notification[] @relation("NotifRecipient")
  notificationsSent     Notification[] @relation("NotifSender")
}

model Follower {
  id        Int            @id @default(autoincrement())
  status    FollowerStatus
  createdAt DateTime       @default(now())

  userId Int
  user   User @relation("UserSent", fields: [userId], references: [id], onDelete: Cascade)

  followerId Int
  follower   User @relation("UserReceived", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([userId, followerId])
}

model Chat {
  id        Int      @id @default(autoincrement())
  text      String?
  image     String?
  createdAt DateTime @default(now())

  userId Int
  user   User @relation("sentMessages", fields: [userId], references: [id], onDelete: Cascade)

  followerId Int
  follower   User @relation("receivedMessages", fields: [followerId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String   // 'FOLLOW_REQUEST', 'MESSAGE', 'FOLLOW_ACCEPT', etc.
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId   Int
  user     User @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation("NotifSender", fields: [senderId], references: [id], onDelete: Cascade)
}
